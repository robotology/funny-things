<application>
    <name>SIFAP</name>

    
    <!-- Movements -->
    <module>
        <name>ctpService</name>
        <parameters>--robot ergocub --part head</parameters>
        <node>ergocub001-lap</node>
    </module>
    <module>
        <name>ctpService</name>
        <parameters>--robot ergocub --part left_arm</parameters>
        <node>ergocub001-lap</node>
    </module>
    <module>
        <name>ctpService</name>
        <parameters>--robot ergocub --part right_arm</parameters>
        <node>ergocub001-lap</node>
    </module>
    <module>
        <name>ctpService</name>
        <parameters>--robot ergocub --part torso</parameters>
        <node>ergocub001-lap</node>
    </module>
    <module>
        <name>yarpdev</name>
        <parameters>--device speech --lingware-context speech --default-language it-IT --robot ergoCub --pitch 80 --speed 100</parameters>
        <node>ergocub-head</node>
    </module>
    <module>
        <name>iSpeak</name>
        <parameters>--package speech-dev</parameters>
        <node>ergocub-head</node>
    </module>

    <connection>
        <from>/iSpeak/speech-dev/rpc</from>
        <to>/ergoCub/speech:rpc</to>
        <protocol>tcp</protocol>
    </connection>
</application>